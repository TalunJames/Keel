# API server
PORT=3001
NODE_ENV=development

# Auth — change before production
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=8h

# SQLite database file (created automatically)
DATABASE_PATH=./data/keel.db

# First admin (created by npm run db:seed if no users exist)
ADMIN_EMAIL=admin@fogsignal.co
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Keel Administrator

# Optional: serve built frontend from API in production
SERVE_STATIC=true

# Voter file storage (Parquet/CSV shards from TargetSmart ingest)
VOTER_DATA_DIR=./data/voter
