# Keel environment configuration — copy to `.env` and fill in.
#   cp .env.example .env
#
# Values here are safe, non-secret placeholders. NEVER commit a real .env.
# Anything marked REQUIRED must be set before the app will start in production.

# ---------- Core server ----------
# Port the API (and, when SERVE_STATIC=true, the built frontend) listens on.
PORT=3001
# `production` enables secure cookies and fail-fast checks. Use `development` locally.
NODE_ENV=development
# When true, the Node server also serves the built Vite frontend from dist/.
# Leave false in dev (Vite dev server handles the frontend on :5173).
SERVE_STATIC=false

# ---------- Auth / sessions ----------
# REQUIRED. Secret used to sign JWT session cookies. In production the server
# refuses to start if this is unset — there is no insecure fallback.
# Generate a strong one: `openssl rand -hex 32`
JWT_SECRET=change-me-openssl-rand-hex-32
# Session lifetime in seconds (numeric). Default is a short TTL if unset.
JWT_EXPIRES_IN_SECONDS=28800
# Force the session cookie's Secure flag. "1" = always secure, "0" = never.
# Leave unset to auto-derive from NODE_ENV (secure in production).
# COOKIE_SECURE=1
# Comma-separated allowlist of public origins (no spaces). Every hostname that
# fronts Keel in the browser must be listed here or its /api/* calls fail CORS.
CORS_ORIGIN=http://localhost:5173
# Number of trusted reverse-proxy hops (Express `trust proxy`). Behind one
# proxy/tunnel this is 1.
TRUST_PROXY_HOPS=1

# ---------- Database / storage ----------
# Path to the main SQLite database file.
DATABASE_PATH=./data/keel.db
# Per-client voter warehouse SQLite indexes live here.
VOTER_DATA_DIR=./data/voter

# ---------- First-boot admin bootstrap ----------
# REQUIRED. Email of the initial administrator. On first boot (empty users
# table) the server prints a one-time `SETUP TOKEN: <random>` to its logs;
# read it with `docker logs <container>`, open the app, and complete the
# first-boot setup screen (enter the token + choose the admin password).
# There is NO ADMIN_PASSWORD env var.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional display name for the bootstrap admin.
BOOTSTRAP_ADMIN_NAME=Administrator
# Set to 1 once to force the bootstrap account back to first-boot setup (then remove).
# BOOTSTRAP_FORCE_RESET=0

# ---------- Integrations ----------
# Shared secret for verifying inbound Cleatus webhooks. Leave blank to disable.
# Webhook URL: POST /api/integrations/cleatus/webhook
CLEATUS_WEBHOOK_SECRET=
# Public base URL used in outbound email links.
APP_URL=http://localhost:5173

# ---------- Outbound email (SMTP) ----------
# Set MAIL_ENABLED=1 to actually send; otherwise mail is a no-op.
MAIL_ENABLED=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "1" for implicit TLS (usually port 465), "0"/unset for STARTTLS.
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Keel <no-reply@example.com>

# ---------- Cloudflare Tunnel (Docker deploy only) ----------
# Tunnel token from the Cloudflare Zero Trust dashboard. Used by the
# cloudflared service in docker-compose.yml.
TUNNEL_TOKEN=

# ---------- Periscope mailer proof viewer ----------
# Vendored under vendor/periscope, served at /periscope
# PERISCOPE_UPLOAD_DIR=./data/periscope/uploads
# PERISCOPE_SHARES_DIR=./data/periscope/shares
# PERISCOPE_MAX_UPLOAD_MB=75

# ---------- Election / ENR collector (EP_* + ELECTION_*) ----------
# Where collector databases and raw captures are written.
ELECTION_DATA_DIR=./data/election
ELECTION_RESULTS_DB_PATH=./data/election/results.db
EP_DB_PATH=./data/election/results.db
EP_RAW_DIR=./data/election/raw
# Start ENR polling automatically on boot ("1") or wait for the UI ("0").
ELECTION_COLLECTOR_AUTO_START=0
# Clarity election ID — 2026 statewide primary is 126592 (state path, not /El_Paso/).
# 124432 is the archived Nov-2025 coordinated test feed (county path only).
EP_EID=126592
# Seconds between polls.
EP_POLL_SECONDS=7
# Enforce a polls-close cutoff ("1") after which polling stops.
EP_ENFORCE_POLLS_CLOSE=0
# ISO-8601 UTC instant when polls close. Must be set per election when
# EP_ENFORCE_POLLS_CLOSE=1 — a stale/past value would immediately halt polling.
EP_POLLS_CLOSE_UTC=2026-07-01T01:00:00+00:00
EP_WATCHDOG_MINUTES=20
# Auto-connect the primary EID (polls state + county manifests, probes for Governor).
EP_AUTO_EID=1
EP_AUTO_EID_START=2026-06-29T06:00:00-06:00
EP_AUTO_EID_END=2026-07-01T08:00:00-06:00
EP_AUTO_EID_INTERVAL_MS=300000
# Comma-separated contest name patterns to track (no spaces around commas).
ELECTION_CONTEST_PATTERNS=Governor,United States Senator,Congress District 5,State Representative District,State Senator District,County Commissioner
# Ballot race reference: public/election-data/ballot-races-2026-primary.json
# Replay mode — disable on election night (uses CSV instead of collector DB)
# ELECTION_REPLAY_CSV=public/election-data/prior-elections/2024-general.csv
