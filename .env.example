# Copy to .env for local development (`npm run dev` loads it via dotenv).
# Never commit a real .env.

# Required in production (dev auto-generates a dev secret if unset).
JWT_SECRET=

# Claude (Anthropic) API key — enables the proposal-editor AI features.
# Without it, the AI controls stay hidden and /proposals/app/api/ai/health
# reports { configured: false }.
# NOTE: keys can also be entered once in the app under Admin → Integrations
# (system admins only). A key saved there is stored in the database and
# overrides this env var — no restart needed. Same for
# ZAPIER_DESIGN_WEBHOOK_URL and CLEATUS_WEBHOOK_SECRET.
ANTHROPIC_API_KEY=
