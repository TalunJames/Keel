# API server
PORT=3001
NODE_ENV=development

# Auth — change before production
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=8h

# SQLite database file (created automatically)
DATABASE_PATH=./data/keel.db

# First admin (created by npm run db:seed if no users exist)
ADMIN_EMAIL=admin@fogsignal.co
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Keel Administrator

# Optional: serve built frontend from API in production
SERVE_STATIC=true

# Voter file storage (Parquet/CSV shards from TargetSmart ingest)
VOTER_DATA_DIR=./data/voter

# ---------------------------------------------------------------------------
# El Paso ENR collector (bundled in election-collector/ — managed from UI)
# ---------------------------------------------------------------------------
ELECTION_DATA_DIR=./data/election
ELECTION_RESULTS_DB_PATH=./data/election/results.db
EP_DB_PATH=./data/election/results.db
EP_RAW_DIR=./data/election/raw

# Start polling when Keel boots (or use Election Monitor → ENR collector panel)
ELECTION_COLLECTOR_AUTO_START=0

# Clarity election ID — use Discover in UI on election night, then Save + Start
EP_EID=124432
EP_ENFORCE_POLLS_CLOSE=0
EP_POLL_SECONDS=7
EP_WATCHDOG_MINUTES=20
EP_POLLS_CLOSE_UTC=2026-07-01T01:00:00+00:00

# Filter ENR contests for the D11-area primary ballot
ELECTION_CONTEST_PATTERNS=Governor,United States Senator,Congress District 5,State Representative District,State Senator District,County Commissioner

# Ballot race reference: public/election-data/ballot-races-2026-primary.json

# Replay mode — disable on election night (uses CSV instead of collector DB)
# ELECTION_REPLAY_CSV=public/election-data/prior-elections/2024-general.csv
